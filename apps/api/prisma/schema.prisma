generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// USER
// ─────────────────────────────────────────

model User {
  id              String      @id @default(cuid())
  phoneHash       String?     @unique
  phoneVerified   Boolean     @default(false)
  phonePrefix     String?
  passwordHash    String?
  email           String?     @unique
  emailVerified   Boolean     @default(false)
  walletAddress   String?     @unique
  walletBoundAt   DateTime?
  displayName     String
  username        String      @unique
  avatarUrl       String?
  bio             String?
  country         String?
  website         String?
  isCreator       Boolean     @default(false)
  isSeller        Boolean     @default(false)
  sellerApplied   Boolean     @default(false)
  sellerApproved  Boolean     @default(false)
  sellerModeOn    Boolean     @default(false)
  trustScore      Int         @default(50)
  riskScore       Int         @default(0)
  status          UserStatus  @default(ACTIVE)
  role            UserRole    @default(MEMBER)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Revocation metadata
  revokedBy       String?
  revokedAt       DateTime?
  revokeReason    String?

  subscription    Subscription?
  creatorStake    CreatorStake?
  sentMessages    Message[]       @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  postedJobs      Job[]           @relation("ClientJobs")
  freelanceJobs   Job[]           @relation("FreelancerJobs")
  proposals       Proposal[]
  content         Content[]
  readStakes      ReadStake[]
  contentReplies  ContentReply[]
  sessions        Session[]
  riskFlags       RiskFlag[]
  securityAudits  SecurityAudit[]
  totpSecret      String?
  totpEnabled     Boolean         @default(false)
  reviewsGiven    Review[]        @relation("ReviewsGiven")
  reviewsReceived Review[]        @relation("ReviewsReceived")
  notifications   Notification[]

  @@index([phoneHash])
  @@index([walletAddress])
  @@index([riskScore])
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  REVOKED
}

enum UserRole {
  MEMBER
  ADMIN
  SUPER_ADMIN
  CONTENT_ADMIN
  FINANCE_ADMIN
  SUPPORT_ADMIN
}

// ─────────────────────────────────────────
// SESSION
// ─────────────────────────────────────────

model Session {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  token              String    @unique
  deviceInfo         String?
  deviceId           String?   // Persistent browser UUID from X-Device-ID header
  deviceName         String?   // Human-readable device name e.g. "Chrome on Windows 11"
  ipAddress          String?
  lastIp             String?
  lastCountry        String?
  userAgent          String?
  lastUserAgent      String?
  hashedRefreshToken String?
  lastSeen           DateTime  @default(now())
  lastRefreshAt      DateTime?
  lastActivityAt     DateTime?
  expiresAt          DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([token])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([lastActivityAt])
}

// ─────────────────────────────────────────
// SUBSCRIPTION
// ─────────────────────────────────────────

model Subscription {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  amountCC        Float     @default(20)
  poolAllocationCC Float    @default(15)
  stakeBalanceCC  Float     @default(5)
  status          SubStatus @default(ACTIVE)
  damlContractId  String?
  renewsAt        DateTime
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

enum SubStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

// ─────────────────────────────────────────
// CREATOR STAKE
// ─────────────────────────────────────────

model CreatorStake {
  id              String      @id @default(cuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id])
  amountCC        Float       @default(100)
  lockedAt        DateTime    @default(now())
  unlockAt        DateTime
  damlContractId  String?
  status          StakeStatus @default(LOCKED)
  createdAt       DateTime    @default(now())

  @@index([userId])
  @@index([status])
}

enum StakeStatus {
  LOCKED
  UNLOCKED
  SLASHED
}

// ─────────────────────────────────────────
// CONTENT
// ─────────────────────────────────────────

model Content {
  id              String        @id @default(cuid())
  creatorId       String
  creator         User          @relation(fields: [creatorId], references: [id])
  title           String
  bodyIpfsHash    String
  type            ContentType   @default(FREE)
  priceCC         Float         @default(0)
  status          ContentStatus @default(PENDING)
  aiScore         Float         @default(0)
  readCount       Int           @default(0)
  avgRating       Float         @default(0)
  delistReason    String?
  adminNote       String?
  topic           String?
  publication     String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  readStakes      ReadStake[]
  replies         ContentReply[]

  @@index([creatorId])
  @@index([status])
  @@index([type])
}

enum ContentType {
  FREE
  PREMIUM
}

enum ContentStatus {
  PENDING
  LIVE
  REJECTED
  DELISTED
}

// ─────────────────────────────────────────
// CONTENT REPLY
// ─────────────────────────────────────────

model ContentReply {
  id          String   @id @default(cuid())
  contentId   String
  content     Content  @relation(fields: [contentId], references: [id])
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  body        String
  createdAt   DateTime @default(now())

  @@index([contentId])
  @@index([authorId])
}

// ─────────────────────────────────────────
// READ STAKE
// ─────────────────────────────────────────

model ReadStake {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  contentId       String
  content         Content         @relation(fields: [contentId], references: [id])
  amountCC        Float           @default(5)
  stakedAt        DateTime        @default(now())
  unstakedAt      DateTime?
  minReadTime     Int             @default(600)
  timerStartedAt  DateTime?
  status          ReadStakeStatus @default(STAKED)
  damlContractId  String?

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
}

enum ReadStakeStatus {
  STAKED
  UNSTAKED
  FORFEITED
}

// ─────────────────────────────────────────
// JOB
// ─────────────────────────────────────────

model Job {
  id              String    @id @default(cuid())
  clientId        String
  client          User      @relation("ClientJobs", fields: [clientId], references: [id])
  freelancerId    String?
  freelancer      User?     @relation("FreelancerJobs", fields: [freelancerId], references: [id])
  title           String
  description     String
  category        String
  skills          String[]
  amountCC        Float
  deadlineDays    Int
  status          JobStatus @default(OPEN)
  damlContractId  String?
  escrowLocked    Boolean   @default(false)
  platformFee     Float     @default(0.05)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  milestones      Milestone[]
  proposals       Proposal[]
  messages        Message[]
  dispute         Dispute?
  reviews         Review[]

  @@index([clientId])
  @@index([freelancerId])
  @@index([status])
}

enum JobStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
}

// ─────────────────────────────────────────
// MILESTONE
// ─────────────────────────────────────────

model Milestone {
  id          String          @id @default(cuid())
  jobId       String
  job         Job             @relation(fields: [jobId], references: [id])
  title       String
  description String?
  amountCC    Float
  order       Int
  status      MilestoneStatus @default(PENDING)
  deliveredAt DateTime?
  approvedAt  DateTime?
  deliveryNotes String?
  deliveryFiles Json?
  createdAt   DateTime        @default(now())

  @@index([jobId])
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
  APPROVED
  DISPUTED
}

// ─────────────────────────────────────────
// PROPOSAL
// ─────────────────────────────────────────

model Proposal {
  id              String          @id @default(cuid())
  jobId           String
  job             Job             @relation(fields: [jobId], references: [id])
  freelancerId    String
  freelancer      User            @relation(fields: [freelancerId], references: [id])
  coverLetter     String
  approach        String?
  rateCC          Float
  deliveryDays    Int
  depositCC       Float           @default(0.5)
  depositPaid     Boolean         @default(false)
  status          ProposalStatus  @default(PENDING)
  createdAt       DateTime        @default(now())

  @@unique([jobId, freelancerId])
  @@index([jobId])
  @@index([freelancerId])
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// ─────────────────────────────────────────
// DISPUTE
// ─────────────────────────────────────────

model Dispute {
  id            String        @id @default(cuid())
  jobId         String        @unique
  job           Job           @relation(fields: [jobId], references: [id])
  raisedById    String
  respondentId  String
  reason        String
  clientClaim   String?
  freelancerClaim String?
  resolution    String?
  clientPct     Float?
  freelancerPct Float?
  status        DisputeStatus @default(OPEN)
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())

  evidence      DisputeEvidence[]

  @@index([jobId])
  @@index([status])
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

model DisputeEvidence {
  id          String   @id @default(cuid())
  disputeId   String
  dispute     Dispute  @relation(fields: [disputeId], references: [id])
  submittedBy String
  fileUrl     String
  fileType    String
  createdAt   DateTime @default(now())

  @@index([disputeId])
}

// ─────────────────────────────────────────
// MESSAGE
// ─────────────────────────────────────────

model Message {
  id          String      @id @default(cuid())
  senderId    String
  sender      User        @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  String
  receiver    User        @relation("ReceivedMessages", fields: [receiverId], references: [id])
  jobId       String?
  job         Job?        @relation(fields: [jobId], references: [id])
  content     String
  fileUrl     String?
  fileType    String?
  read        Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([jobId])
}

// ─────────────────────────────────────────
// PLATFORM CONFIG
// ─────────────────────────────────────────

model PlatformConfig {
  // Fixed singleton ID — always "platform". Never insert a second row.
  id                          String    @id @default("platform")

  // ── Existing Economics & Governance (unchanged) ──────────────────
  subscriptionAmountCC        Float     @default(20)
  poolAllocationCC            Float     @default(15)
  stakeBalanceCC              Float     @default(5)
  platformFeeSub              Float     @default(0.30)
  platformFeeFreelance        Float     @default(0.05)
  readStakeAmountCC           Float     @default(5)
  minReadTimeSeconds          Int       @default(600)
  gracePeriodHours            Int       @default(2)
  creatorStakeCC              Float     @default(100)
  creatorLockDays             Int       @default(14)
  maxContentPerMonth          Int       @default(5)
  dailyCheckinCC              Float     @default(0.05)
  proposalDepositCC           Float     @default(0.5)
  minTreasuryReserveCC        Float     @default(10000)
  incentivePhaseActive        Boolean   @default(true)

  // ── State Version (increment on every update) ────────────────────
  // Frontend ignores Socket.IO payloads with version <= lastKnownVersion
  version                     Int       @default(1)

  // ── Global & Service Maintenance (manual emergency flags) ────────
  // IMPORTANT: These flags are NEVER automatically reset by maintenance
  // window expiry — they require explicit SUPER_ADMIN action to clear.
  globalMaintenance           Boolean   @default(false)
  globalMaintenanceReason     String?   @default("The platform is currently undergoing scheduled maintenance. We'll be back shortly.")
  freelancingMaintenance      Boolean   @default(false)
  freelancingMaintenanceReason String?  @default("The freelancing service is currently under maintenance. Please check back later.")
  contentMaintenance          Boolean   @default(false)
  contentMaintenanceReason    String?   @default("Content publishing is temporarily paused.")
  messagingMaintenance        Boolean   @default(false)
  messagingMaintenanceReason  String?   @default("Messaging is temporarily paused for maintenance.")
  registrationPaused          Boolean   @default(false)
  registrationPausedReason    String?   @default("New user registrations are temporarily paused.")
  loginPaused                 Boolean   @default(false)
  loginPausedReason           String?   @default("Login is temporarily restricted for maintenance.")

  // ── Financial & Payment Emergency Controls (manual) ──────────────
  walletPaused                Boolean   @default(false)
  walletPausedReason          String?   @default("Wallet services are temporarily unavailable.")
  depositPaused               Boolean   @default(false)
  depositPausedReason         String?   @default("Deposits are temporarily paused.")
  withdrawPaused              Boolean   @default(false)
  withdrawPausedReason        String?   @default("Withdrawals are temporarily paused.")
  escrowCreatePaused          Boolean   @default(false)
  escrowCreatePausedReason    String?   @default("Escrow creation is temporarily paused.")
  escrowReleasePaused         Boolean   @default(false)
  escrowReleasePausedReason   String?   @default("Escrow releases are temporarily paused.")
  otcTradingPaused            Boolean   @default(false)
  otcTradingPausedReason      String?   @default("OTC trading is temporarily paused.")

  // ── System & Infrastructure Controls (manual) ────────────────────
  creatorPaused               Boolean   @default(false)
  creatorPausedReason         String?   @default("Creator features are temporarily paused.")
  notificationsPaused         Boolean   @default(false)
  emailSendingPaused          Boolean   @default(false)
  smsVerificationPaused       Boolean   @default(false)

  // ── Country Access Control ────────────────────────────────────────
  // ISO 3166-1 alpha-2 codes e.g. ["US", "IR", "KP"]
  restrictedCountries         String[]  @default([])

  // ── Scheduled Maintenance Banner ──────────────────────────────────
  // ISOLATED from manual emergency pauses — window expiry only hides
  // the banner. It never clears any of the manual pause flags above.
  bannerEnabled               Boolean   @default(false)
  bannerTitle                 String?   @default("Scheduled Maintenance")
  bannerMessage               String?   @default("CanaFri will undergo scheduled maintenance. Some services may be temporarily unavailable.")
  bannerStart                 DateTime?
  bannerEnd                   DateTime?
  bannerDismissible           Boolean   @default(true)

  // ── Audit ─────────────────────────────────────────────────────────
  updatedAt                   DateTime  @updatedAt
  updatedBy                   String?
}

// ─────────────────────────────────────────
// ─────────────────────────────────────────
// RISK FLAG
// ─────────────────────────────────────────

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model RiskFlag {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  sessionId  String?
  severity   RiskSeverity @default(LOW)
  flag       String       // e.g. "UA_PATCH_CHANGE", "SUBNET_SHIFT", "TOKEN_THEFT_DETECTED"
  metadata   Json?        // Extra context: old/new IP, UA, country etc.
  resolved   Boolean      @default(false)
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([userId])
  @@index([severity])
  @@index([resolved])
  @@index([resolvedAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String
  category  String    @default("FREELANCE")
  actorId   String?
  targetId  String?
  read      Boolean   @default(false)
  link      String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([read])
  @@index([category])
  @@index([deletedAt])
}

// ─────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  adminId     String?
  userId      String?
  action      String
  target      String?
  before      Json?
  after       Json?
  ipAddress   String?
  device      String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([userId])
}

// ─────────────────────────────────────────
// ADMIN INVITE
// ─────────────────────────────────────────

model AdminInvite {
  id        String   @id @default(cuid())
  email     String   @unique
  role      UserRole
  token     String   @unique
  invitedBy String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

// ─────────────────────────────────────────
// REVIEW
// ─────────────────────────────────────────

model Review {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])
  reviewerId  String
  reviewer    User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId  String
  reviewee    User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  rating      Float    // 1.0 to 5.0
  comment     String?
  createdAt   DateTime @default(now())

  @@index([jobId])
  @@index([reviewerId])
  @@index([revieweeId])
}

// ─────────────────────────────────────────
// SECURITY AUDIT
// ─────────────────────────────────────────

model SecurityAudit {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  sessionId  String?
  deviceId   String?  // Persistent browser device UUID
  action     String   // e.g. "LOGIN", "LOGOUT", "REFRESH_ROTATED", "TOKEN_THEFT_DETECTED"
  ipAddress  String?
  country    String?
  userAgent  String?
  metadata   Json?    // Extra context: risk level, flag type, etc.
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([deviceId])
  @@index([createdAt])
}
